    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Grab the raw model text\nconst raw = $input.item.json.output[0].content[0].text;\n\n// Extract the JSON object (drops code fences / any surrounding text)\nlet jsonStr = raw.match(/{[\\s\\S]*}/)[0];\n\n// Fix stray literal line breaks / tabs INSIDE string values,\n// which are illegal in JSON and cause \"Bad control character\".\nlet cleaned = \"\";\nlet insideString = false;\nfor (let i = 0; i < jsonStr.length; i++) {\n  const ch = jsonStr[i];\n  if (ch === '\"' && jsonStr[i - 1] !== '\\\\') {\n    insideString = !insideString;\n    cleaned += ch;\n  } else if (insideString && ch === '\\n') {\n    cleaned += '\\\\n';\n  } else if (insideString && ch === '\\r') {\n    // skip carriage returns\n  } else if (insideString && ch === '\\t') {\n    cleaned += '\\\\t';\n  } else {\n    cleaned += ch;\n  }\n}\n\nconst parsed = JSON.parse(cleaned);\n\nreturn {\n  TikTok: parsed.TikTok,\n  LinkedIn: parsed.LinkedIn,\n  Facebook: parsed.Facebook,\n};"
      },
