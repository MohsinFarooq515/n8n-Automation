    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const row = item.json;\n\n  let authors = row.Author || '';\n\n  try {\n    const parsedAuthors = JSON.parse(authors);\n\n    if (Array.isArray(parsedAuthors)) {\n      authors = parsedAuthors.join(', ');\n    }\n  } catch (error) {\n    // Keep the original author value\n  }\n\n  return {\n    json: {\n      ...row,\n      facebookText: `${row.Summary}\\n\\nAuthor: ${authors}`,\n      facebookImage: row['Image URL']\n    }\n  };\n});"
      },
