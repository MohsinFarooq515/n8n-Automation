    {
      "parameters": {
        "jsCode": "// Get the raw input - in your case it's a plain string, not an items array\nconst raw = $input.first().json.data;\nlet html;\nif (typeof raw === 'string') {\n  html = raw;\n} else if (Array.isArray(raw)) {\n  const first = raw[0];\n  html = first?.json?.data || first?.json?.html || first?.json?.body || first?.data;\n} else {\n  html = JSON.stringify(raw);\n}\nif (!html || typeof html !== 'string') {\n  return [{ json: { error: 'Could not extract HTML string', gotType: typeof html } }];\n}\nconst articles = [];\nconst chunks = html.split('<li class=\"wp-block-post ').slice(1);\nfor (const chunk of chunks) {\n  const titleMatch = chunk.match(\n    /<a[^>]*href=\"([^\"]+)\"\\s+class=\"loop-card__title-link\"[^>]*>([^<]*)<\\/a>/\n  );\n  if (!titleMatch) continue;\n\n  // Post ID sits at the very start of the chunk, e.g. \"post-3158531 post type-post...\"\n  const postIdMatch = chunk.match(/^post-(\\d+)/);\n\n  const imgMatch = chunk.match(/<img[^>]*src=\"([^\"]+)\"[^>]*alt=\"([^\"]*)\"/);\n  const categoryMatch = chunk.match(/class=\"loop-card__cat\"[^>]*>([^<]+)</);\n  const timeMatch = chunk.match(/<time datetime=\"([^\"]+)\"[^>]*>\\s*([^<]+)<\\/time>/);\n  const authorBlockMatch = chunk.match(/loop-card__author-list\">([\\s\\S]*?)<\\/ul>/);\n  const authors = authorBlockMatch\n    ? [...authorBlockMatch[1].matchAll(/class=\"loop-card__author\"[^>]*>([^<]+)<\\/a>/g)]\n        .map(m => m[1].trim())\n    : [];\n\n  articles.push({\n    postId: postIdMatch ? postIdMatch[1] : null,\n    title: titleMatch[2].trim(),\n    url: titleMatch[1],\n    image: imgMatch ? imgMatch[1] : null,\n    imageAlt: imgMatch ? imgMatch[2] : null,\n    category: categoryMatch ? categoryMatch[1].trim() : null,\n    isBrief: /loop-card--brief/.test(chunk),\n    publishedAt: timeMatch ? timeMatch[1] : null,\n    publishedRelative: timeMatch ? timeMatch[2].trim() : null,\n    authors,\n  });\n}\nconst seen = new Set();\nconst uniqueArticles = articles.filter(a => {\n  if (seen.has(a.url)) return false;\n  seen.add(a.url);\n  return true;\n});\nreturn uniqueArticles.map(a => ({ json: a }));"
      },
